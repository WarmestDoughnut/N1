# N1 Hub backend configuration (all optional — unset = local demo behaviour).
#
# DATABASE_URL: Supabase Postgres connection string. When set, app state (accounts, connections,
#   plans, results, episodes) is stored in Postgres instead of data/store.json. The backend
#   auto-creates the tables on startup (see app/persistence.py / db/schema.sql).
#   Supabase: Project → Settings → Database → Connection string (URI).
# DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-REF.supabase.co:5432/postgres
#
# ALLOWED_ORIGINS: comma-separated extra CORS origins. *.vercel.app is already allowed.
# ALLOWED_ORIGINS=https://n1hub.example.com
